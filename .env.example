# ── Core ────────────────────────────────────────────────
# Comma-separated domains this instance hands out DISPOSABLE addresses on, and
# accepts mail for. Every address on them is readable by anyone who knows it.
#
# Keep these separate from the domain your site runs on (SITE_ADDRESS below).
# Two reasons: `admin@` and `billing@` on a domain listed here would be public
# too, and signup forms collect and block temp-mail domains — burning your brand
# domain takes your outbound reputation with it. A subdomain (mail.example.com)
# or throwaway domains you can rotate are both fine; the list takes several, and
# community domains add more at runtime.
MAIL_DOMAINS=example.com

# Public base URL of the web app (used in links, CORS).
PUBLIC_WEB_URL=http://localhost:3000

# TTL (minutes) before a message auto-expires and is purged.
MESSAGE_TTL_MINUTES=60

# TTL (minutes) a generated address stays reserved to you (renewed each visit).
RESERVATION_TTL_MINUTES=1440

# ── Postgres ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fana
DB_USER=fana
# Generate one for a real deploy: `openssl rand -hex 24`. Hex on purpose — it
# survives every .env parser and URL without escaping.
#
# Read only when the database volume is first created. Changing it later does
# nothing on its own; see the note in docker-compose.yml.
DB_PASSWORD=fana
# Optional: force TLS to the database (true/false).
DB_SSL=false
# Apply pending DB migrations when the API boots (idempotent). Set false to run
# them as a separate deploy step: `pnpm db:migrate`.
MIGRATE_ON_START=true
# Host port docker-compose publishes Postgres on. Bump (e.g. 5433) if a local
# Postgres already owns 5432 — then set DB_PORT to the same value.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ── Redis (realtime pubsub + rate-limit) ────────────────
REDIS_URL=redis://localhost:6379

# ── Attachment storage ──────────────────────────────────
# db = inline in Postgres (default, zero-config). s3 = object storage.
STORAGE_DRIVER=db
# Only used when STORAGE_DRIVER=s3 (works with AWS S3, Cloudflare R2, MinIO):
# S3_BUCKET=fana-attachments
# S3_REGION=auto
# S3_ENDPOINT=            # e.g. https://<id>.r2.cloudflarestorage.com or http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # set true for MinIO

# ── SMTP inbound ────────────────────────────────────────
SMTP_HOST=0.0.0.0
SMTP_PORT=25
# Max accepted message size in bytes (default 10MB).
SMTP_MAX_SIZE=10485760
# Hostname this MTA reports when running SPF/DKIM/DMARC checks (cosmetic).
MAIL_AUTH_MTA=mx.example.com
# Resolve the sender's PTR record before greeting them. Off by default: the
# lookup blocks the 220 for up to 1.5s and nothing here uses the result — SPF
# uses the HELO name the client announced, abuse screening uses the IP.
SMTP_REVERSE_LOOKUP=false

# ── Community domains ───────────────────────────────────
# Public MX hostname the community points their domain's MX record at.
PUBLIC_MX_HOST=mx.example.com
# Ownership check: "mx" requires the domain's MX to point at PUBLIC_MX_HOST;
# "off" auto-verifies (use locally — localhost domains can't be MX-pointed).
DOMAIN_VERIFY=mx
# Per-IP inbound flood guard: max messages per window (0 = disabled).
SMTP_RATE_LIMIT_MAX=30
SMTP_RATE_LIMIT_WINDOW_SECONDS=60

# ── API ─────────────────────────────────────────────────
# Port the api process listens on *inside* its container. Leave it alone unless
# you also change API_UPSTREAM to match — Caddy reaches the service over the
# compose network, not through a host port.
API_PORT=4000
# Host ports the api and web containers are published on, bound to 127.0.0.1.
# Only for reaching them directly from the server (curl, a debug session);
# public traffic goes through the proxy. Container ports can never clash with
# anything on the host, so these are the only numbers worth changing.
API_HOST_PORT=4000
WEB_HOST_PORT=3000
# Requests per IP per window for public endpoints.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# ── Admin ───────────────────────────────────────────────
# No secret lives here. On first boot the API creates an admin account and an
# API token and prints both once — grab them from the logs, then manage
# accounts and rotate the token in /admin → Access.
#
# Optional, for scripted installs only: seed the first account instead of
# having a password generated. Ignored once an admin exists.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Where the dashboard is served, for a fresh instance only. After first boot
# this lives in the database — change it in /admin → Access → Dashboard URL,
# no restart needed. Moving it off /admin makes /admin 404 like any missing page.
ADMIN_PATH=admin

# ── Customer sign-in (GitHub OAuth) ─────────────────────
# Customers sign in with GitHub, which is why this app needs no outbound email.
# Leave blank and sign-in is simply not offered; operators still use a password.
# Create the app at https://github.com/settings/developers with the callback
# set to <PUBLIC_API_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# How long a dashboard sign-in lasts (sliding — activity extends it).
ADMIN_SESSION_TTL_MINUTES=720
# Failed sign-ins before the lockout window starts rejecting attempts.
LOGIN_MAX_ATTEMPTS_IP=10
LOGIN_MAX_ATTEMPTS_USER=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
# Requests per IP per window for /api/admin (separate from the public budget).
ADMIN_RATE_LIMIT_MAX=600
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
# Sign-in attempts per IP per window (the lockout above is the real defence).
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ── Webhooks ────────────────────────────────────────────
# Allow customer endpoints on private/loopback addresses and plain http. Off in
# production: a webhook makes this server fetch a URL a customer chose, which
# reaches cloud metadata and your own network unless something says no. Turn it
# on for local development, where the only receiver anyone has is on localhost.
WEBHOOK_ALLOW_PRIVATE=false

# ── Reverse proxy (infra/Caddyfile) ─────────────────────
# Public host Caddy serves + gets a TLS cert for. localhost = no HTTPS.
# This is your *brand* domain — the website, the dashboard and the API live
# here. It should not appear in MAIL_DOMAINS; see the note there.
SITE_ADDRESS=localhost
# Upstream service targets (defaults suit docker-compose).
API_UPSTREAM=api:4000
WEB_UPSTREAM=web:3000

# ── Branding (white-label) ──────────────────────────────
# Only the site name lives here — it seeds a fresh instance. Everything else
# (tagline, accent colour, logo, favicon) is edited in /admin → Branding,
# stored in the DB, and applied live without a rebuild.
SITE_NAME=fana
# Browser-facing API URL the web app calls.
PUBLIC_API_URL=http://localhost:4000
