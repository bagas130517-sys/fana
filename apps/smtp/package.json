    "ioredis": "^5.4.1",
    "mailauth": "^4.6.9",
    "mailparser": "^3.7.1",
    "smtp-server": "^3.13.6"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.7.4",
    "@types/smtp-server": "^3.5.10",
    "dotenv-cli": "^7.4.2",
    "tsx": "^4.19.1"
  }
