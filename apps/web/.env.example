# URL of the fana API (browser-facing, so must be reachable from the client).
# The only web var baked at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# API URL used for server-side rendering (branding lookup). Defaults to the
# public one; set it when the API is only reachable on an internal network.
API_INTERNAL_URL=

# Site name shown in the header/title. The rest of the branding (tagline,
# accent, logo, favicon) is edited in /admin → Branding.
SITE_NAME=fana
